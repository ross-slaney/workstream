[Unit]
Description=Workstream desktop: host.docker.internal reaches this machine from its containers
# Before Docker makes its first network. It needs nothing but the kernel, so it holds nothing up.
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /opt/workstream/image/host-docker-internal.nft

[Install]
WantedBy=multi-user.target
