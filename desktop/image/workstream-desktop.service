[Unit]
Description=Workstream desktop: the display, the session and the agent
# Ordered after nothing but the basics. The display and the session need no network, so they come up while
# the network does; the agent asks until it is there. Docker starts beside all of it.

[Service]
User=work
Group=work
# The session's own files (its message bus, its sockets): /run/workstream, in memory, gone when the machine stops.
RuntimeDirectory=workstream
RuntimeDirectoryMode=0700
ExecStart=/opt/workstream/start.sh
# A project's stack opens many files at once (a bundler, a database, an editor).
LimitNOFILE=1048576
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
