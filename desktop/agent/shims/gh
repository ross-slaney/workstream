#!/bin/sh
# gh on a Workstream desktop, first on every shell's PATH and the agent's (agent.mjs, harness.mjs). It signs gh in
# as the person who started the task, with their GitHub token, asked for each time gh runs (../github.mjs), so
# none is written down. A GH_TOKEN or GITHUB_TOKEN already set wins. When there is none, github.mjs says why
# on stderr, before gh says it is not signed in.
if [ -z "${GH_TOKEN:-}" ] && [ -z "${GITHUB_TOKEN:-}" ]; then
  token=$(node "$(dirname "$0")/../github.mjs" token)
  if [ -n "$token" ]; then
    GH_TOKEN=$token
    export GH_TOKEN
  fi
fi
exec /usr/bin/gh "$@"
