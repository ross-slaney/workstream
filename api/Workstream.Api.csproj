<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The API. apphost/ runs it (with SQL Server); the tests reference it. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Workstream</AssemblyName>
    <RootNamespace>Workstream.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The apps a desktop can come with: one list, read here, by the image's install script and by the desktop at boot. -->
    <EmbeddedResource Include="../desktop/apps.json" LogicalName="Workstream.Apps.json" />
    <!-- The words of the emails the API sends: every word a key, beside the app's own (client/locales). -->
    <EmbeddedResource Include="../client/locales/emails/en.json" LogicalName="Workstream.Emails.en.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Workstream.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="SqlOS" Version="11.5.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="EFCore.SchemaSync" Version="0.4.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
    <PackageReference Include="Hangfire.Core" Version="1.8.14" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <!-- workstream.yml, read strictly (Domain/WorkstreamFile.cs). -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

</Project>
