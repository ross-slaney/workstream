# Local settings. Copy to .env to change any of them; the AppHost runs on these defaults without one.
# Only the model values have no default: `./scripts/dev-env.sh` writes them from Azure.

PUBLIC_ORIGIN=http://localhost:5280
WEB_ORIGIN=http://localhost:8091
# The local SQL Server container's own password. It protects nothing outside this computer.
CONNECTION_STRING=Server=localhost,1454;Database=Workstream;User Id=sa;Password=Workstream-dev-1;TrustServerCertificate=True

# The system administrator in development: sign in with this email and password to see /admin.
WORKSTREAM_ADMIN_EMAIL=admin@workstream.test
WORKSTREAM_ADMIN_PASSWORD=Workstream-dev-1

# Where desktops run in development: docker (desktop/Dockerfile) or none.
WORKSTREAM_DESKTOP_HOST=docker

# The agent's models: Workstream's Foundry resource and its key (README, "Models").
WORKSTREAM_MODEL_ENDPOINT=
WORKSTREAM_MODEL_KEY=
