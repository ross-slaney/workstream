<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Journeys through the API (api/), plus the domain's pure logic. SQL Server and the database come from the
    real AppHost, started through Aspire.Hosting.Testing without its api and web resources (Stack.cs); the API
    runs in this process instead, so coverage sees it, with the desktops and the model played here
    (FakeDesktops.cs, FakeModel.cs). Every test reaches the API over HTTP, as a person's browser or a desktop
    would (Person.cs, Desktop.cs).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Workstream.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../api/Workstream.Api.csproj" />
    <ProjectReference Include="../../apphost/Workstream.AppHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" Version="13.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
